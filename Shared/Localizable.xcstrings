    "Sunscreen, sunglasses and a hat, and shade around midday when the sun is strongest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم واقي الشمس والنظارات الشمسية والقبعة، وابقَ في الظل وقت الظهيرة حين تكون الشمس في أقوى حالاتها."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protector solar, gafas de sol y gorra, y sombra hacia el mediodía, cuando el sol pega más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crème solaire, lunettes et chapeau, et de l’ombre vers midi, quand le soleil tape le plus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日焼け止め、サングラス、帽子を。日差しが最も強い正午前後は日陰へ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protetor solar, óculos de sol e chapéu, e sombra perto do meio-dia, quando o sol está mais forte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "涂防晒霜、戴墨镜和帽子，中午阳光最强时待在阴凉处。"
          }
        }
      }
    },
