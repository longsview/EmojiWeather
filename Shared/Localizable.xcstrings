    "When Reduce Motion is on, scenes move slowly and lightning doesn't flash. Turn this off for still scenes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل تقليل الحركة، تتحرك المشاهد ببطء ولا يومض البرق. أوقف هذا الخيار للحصول على مشاهد ثابتة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Reducir movimiento, las escenas se mueven despacio y los rayos no destellan. Desactívalo para escenas fijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Réduire les animations, les scènes bougent lentement et les éclairs ne clignotent pas. Désactivez pour des scènes fixes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」がオンのときは、シーンがゆっくり動き、稲妻は光りません。オフにすると静止したシーンになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Reduzir Movimento ativado, as cenas se movem devagar e os raios não piscam. Desative para cenas estáticas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“减弱动态效果”后，场景会缓慢移动，闪电不会闪烁。关闭此项可显示静态场景。"
          }
        }
      }
    },
