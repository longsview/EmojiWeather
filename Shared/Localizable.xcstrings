    "Down %@ over the next 12 hours, often ahead of a storm. Some people notice headaches or achy joints when pressure falls quickly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سينخفض %@ خلال الساعات الـ12 القادمة، وغالبًا ما يسبق ذلك عاصفة. يشعر بعض الناس بصداع أو آلام في المفاصل عندما ينخفض الضغط بسرعة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bajará %@ en las próximas 12 horas, a menudo antes de una tormenta. Algunas personas notan dolor de cabeza o de articulaciones cuando la presión baja rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baisse de %@ dans les 12 prochaines heures, souvent avant un orage. Certaines personnes ressentent des maux de tête ou des douleurs articulaires quand la pression chute vite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後12時間で%@低下します。嵐の前によく起こります。気圧が急に下がると、頭痛や関節の痛みを感じる人もいます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queda de %@ nas próximas 12 horas, muitas vezes antes de uma tempestade. Algumas pessoas sentem dor de cabeça ou nas articulações quando a pressão cai rápido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未来 12 小时将下降 %@，通常预示着暴风雨。有些人在气压快速下降时会感到头痛或关节酸痛。"
          }
        }
      }
    },
    "Dress up every scene for the season, or swap the sun, moon, clouds and more for your own emoji or Genmoji." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زيّن كل مشهد حسب الموسم، أو استبدل الشمس والقمر والسحب وغيرها بإيموجي أو Genmoji خاص بك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viste cada escena según la temporada o cambia el sol, la luna, las nubes y más por tus propios emojis o Genmoji."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habillez chaque scène pour la saison, ou remplacez le soleil, la lune, les nuages et plus par vos propres emoji ou Genmoji."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "季節に合わせてシーンを着せ替えたり、太陽・月・雲などを好きな絵文字やジェン文字に変えたりできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decore cada cena para a estação ou troque o sol, a lua, as nuvens e mais pelos seus próprios emojis ou Genmoji."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个场景换上季节装扮，或把太阳、月亮、云朵等换成你自己的表情符号或 Genmoji。"
          }
        }
      }
    },
    "Drink water, take breaks in the shade and check on people who feel the heat more." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشرب الماء، واسترح في الظل، واطمئن على من يتأثرون بالحر أكثر."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua, descansa a la sombra y pendiente de quienes sufren más el calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buvez de l’eau, faites des pauses à l’ombre et prenez des nouvelles des personnes fragiles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水分をとり、日陰で休み、暑さに弱い人に気を配りましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beba água, faça pausas na sombra e fique de olho em quem sente mais o calor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多喝水，在阴凉处休息，并多关照怕热的人。"
          }
        }
      }
    },
