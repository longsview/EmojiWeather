    "Secure loose things outside and watch for falling branches." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت الأشياء غير المثبتة في الخارج واحذر من تساقط الأغصان."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegura lo que tengas suelto fuera y cuidado con las ramas que caen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangez ce qui traîne dehors et méfiez-vous des chutes de branches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋外の飛ばされやすい物を固定し、落ちてくる枝に注意しましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenda o que estiver solto lá fora e cuidado com galhos caindo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定好户外松散的物品，小心掉落的树枝。"
          }
        }
      }
    },
    "See storms, sun and temperatures across the map, like the old TV weather." : {
      "localizations" : {
