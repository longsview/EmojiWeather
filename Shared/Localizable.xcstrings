        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático sigue tu región en Ajustes > General > Idioma y región."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique suit votre région dans Réglages > Général > Langue et région."
