    "Countries, capitals and flags in Skymoji Daily come from mledoze/countries, used under the ODbL 1.0." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي الدول والعواصم والأعلام في Skymoji Daily من mledoze/countries وتُستخدم بموجب ترخيص ODbL 1.0."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los países, capitales y banderas de Skymoji Daily provienen de mledoze/countries, con licencia ODbL 1.0."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pays, capitales et drapeaux de Skymoji Daily proviennent de mledoze/countries, sous licence ODbL 1.0."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skymoji Dailyの国、首都、国旗はmledoze/countriesのデータをODbL 1.0で使用しています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os países, capitais e bandeiras do Skymoji Daily vêm de mledoze/countries, sob a licença ODbL 1.0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skymoji Daily 中的国家、首都和国旗来自 mledoze/countries，依据 ODbL 1.0 许可使用。"
          }
        }
      }
    },
    "Cover exposed skin and keep time outside short. Frostbite can start quickly in the wind." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غطِّ الجلد المكشوف وقلّل وقتك في الخارج. قد تبدأ قضمة الصقيع سريعًا مع الرياح."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubre la piel expuesta y limita el tiempo fuera. Con viento, la congelación puede llegar rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couvrez la peau exposée et limitez le temps dehors. Les gelures peuvent apparaître vite avec le vent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肌の露出を避け、外にいる時間を短くしましょう。風があると凍傷はすぐに起こります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubra a pele exposta e fique pouco tempo ao ar livre. Com vento, o congelamento pode começar rápido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遮盖裸露的皮肤，减少在户外的时间。有风时很快就可能冻伤。"
          }
        }
      }
    },
