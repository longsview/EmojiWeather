    "Your cities sync to all your devices through iCloud." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتزامن مدنك مع كل أجهزتك عبر iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus ciudades se sincronizan en todos tus dispositivos con iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos villes se synchronisent sur tous vos appareils via iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都市はiCloudですべてのデバイスに同期されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
