    "The free version shows ads from Google AdMob. Skymoji+ removes them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض النسخة المجانية إعلانات من Google AdMob. يزيلها Skymoji+."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión gratis muestra anuncios de Google AdMob. Skymoji+ los quita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version gratuite affiche des pubs Google AdMob. Skymoji+ les supprime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料版にはGoogle AdMobの広告が表示されます。Skymoji+で非表示にできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
