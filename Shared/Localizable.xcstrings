    "Free for 7 days, then %@ a year. Cancel anytime in Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant 7 jours, puis %@ par an. Annulez à tout moment dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis 7 días y luego %@ al año. Cancela cuando quieras en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis por 7 dias, depois %@ por ano. Cancele quando quiser em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费 7 天，之后每年 %@。可随时在“设置”中取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間無料、その後は年額%@。設定からいつでも解約できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجانًا لـ7 أيام، ثم %@ سنويًا. يمكنك الإلغاء متى شئت من الإعدادات."
          }
        }
      }
    },
    "Free includes %lld cities (%lld used).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite inclut %1$lld villes (%2$lld utilisées)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratis incluye %1$lld ciudades (%2$lld en uso)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão grátis inclui %1$lld cidades (%2$lld em uso)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版包含 %1$lld 个城市（已用 %2$lld 个）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版は%1$lld都市まで（%2$lld都市を使用中）。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن النسخة المجانية %1$lld مدن (مستخدم منها %2$lld)."
          }
        }
      }
    },
    "Free includes %lld cities. EmojiWeather+ removes the limit.": {
      "localizations": {
