    "Packs add a few seasonal emoji to every scene. The weather itself stays real." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تضيف الحزم بعض الإيموجي الموسمية إلى كل مشهد. ويبقى الطقس حقيقيًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los packs añaden algunos emojis de temporada a cada escena. El tiempo sigue siendo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les packs ajoutent quelques emoji de saison à chaque scène. La météo, elle, reste réelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パックは各シーンに季節の絵文字を少し加えます。天気そのものは本物のままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
