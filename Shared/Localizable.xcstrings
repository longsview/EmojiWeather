    "Your cities sync to all your devices through iCloud.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos villes se synchronisent sur tous vos appareils via iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ciudades se sincronizan en todos tus dispositivos con iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas cidades são sincronizadas com todos os seus dispositivos pelo iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的城市会通过 iCloud 同步到所有设备。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市はiCloudですべてのデバイスに同期されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتزامن مدنك مع كل أجهزتك عبر iCloud."
          }
        }
      }
    },
    "Your weather as emoji. Tap the arrow to step through your places.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre météo en emoji. Touchez la flèche pour passer d’un lieu à l’autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tiempo en emoji. Toca la flecha para pasar por tus lugares."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu clima em emoji. Toque na seta para alternar entre seus lugares."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用表情符号看天气。轻点箭头切换地点。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気を絵文字で。矢印をタップして場所を切り替えます。"
