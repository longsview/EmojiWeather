          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point de rosée"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "露点"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponto de orvalho"
          }
        },
        "zh-Hans" : {
