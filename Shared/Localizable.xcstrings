    "Automatic follows your region in iOS Settings > General > Language & Region." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع الخيار التلقائي منطقتك في الإعدادات > عام > اللغة والمنطقة."
