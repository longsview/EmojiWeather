    "The App Store couldn't verify this purchase. Try Restore Purchases, or try again in a moment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على App Store التحقق من عملية الشراء هذه. جرّب استعادة المشتريات، أو حاول مرة أخرى بعد قليل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El App Store no pudo verificar esta compra. Prueba Restaurar compras o inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’App Store n’a pas pu vérifier cet achat. Essayez Restaurer les achats, ou réessayez dans un instant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store でこの購入を確認できませんでした。「購入を復元」を試すか、しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store não conseguiu verificar esta compra. Tente Restaurar Compras ou tente novamente em instantes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 无法验证此购买。请尝试恢复购买，或稍后再试。"
          }
        }
      }
    },
    "The App Store isn't available right now. Try again in a moment." : {
