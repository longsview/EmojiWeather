    "Allow location access to see the weather right where you are. It's only used to get your forecast.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à votre position pour voir la météo là où vous êtes. Elle sert uniquement à obtenir vos prévisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tu ubicación para ver el tiempo justo donde estás. Solo se usa para obtener tu pronóstico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à localização para ver o clima exatamente onde você está. Ela só é usada para obter sua previsão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问位置即可查看你所在地的天气。位置仅用于获取预报。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスを許可すると、今いる場所の天気が表示されます。予報の取得にのみ使用します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى موقعك لترى الطقس حيث أنت بالضبط. يُستخدم فقط للحصول على توقعاتك."
          }
        }
      }
    },
