            "value" : "露点"
          }
        }
      }
    },
    "Dew point %@. Sweat dries slowly, so heat feels harder on the body. Pace yourself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقطة الندى %@. يجفّ العرق ببطء فيصبح الحر أثقل على الجسم. خذ الأمور بهدوء."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto de rocío %@. El sudor se seca despacio y el calor cansa más. Tómatelo con calma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point de rosée %@. La transpiration sèche lentement, la chaleur pèse davantage. Ménagez-vous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "露点 %@。汗が乾きにくく、暑さが体にこたえます。無理をしないで。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponto de orvalho %@. O suor seca devagar e o calor pesa mais no corpo. Vá com calma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "露点 %@。汗水蒸发慢，身体更难散热。注意节奏，别太勉强。"
          }
        }
      }
    },
