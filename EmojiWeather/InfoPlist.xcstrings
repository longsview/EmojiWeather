{
  "sourceLanguage": "en",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Location permission prompt",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "EmojiWeather uses your location to show the weather where you are."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EmojiWeather utilise votre position pour afficher la météo là où vous êtes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EmojiWeather usa tu ubicación para mostrar el tiempo donde estás."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O EmojiWeather usa sua localização para mostrar o clima onde você está."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EmojiWeather 使用你的位置来显示你所在地的天气。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EmojiWeatherは現在地の天気を表示するために位置情報を使用します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم EmojiWeather موقعك لعرض الطقس حيث أنت."
          }
        }
      }
    }
  },
  "version": "1.0"
}